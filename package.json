{
  "name": "storeluma", "version": "0.4.0", "private": true, "type": "module",
  "engines": {"node": ">=24"},
  "scripts": {
    "setup": "node tools/dev-setup.mjs",
    "build": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "test": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3", "@nestjs/core": "12.1.3", "@nestjs/platform-express": "12.1.3",
    "amqplib": "^0.10.9", "cookie-parser": "^1.4.7", "express": "^5.1.0",
    "jose": "^6.1.3", "openid-client": "6.8.8", "pg": "^8.16.3",
    "react": "19.3.0", "react-dom": "19.3.0", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1", "@types/amqplib": "^0.10.7", "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3", "@types/node": "^24.10.0", "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2", "@types/react-dom": "^19.2.2", "typescript": "^5.9.3", "vite": "^7.1.12"
  }
}
