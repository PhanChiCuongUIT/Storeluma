# Public IPv4 and registered domain. The installer uses shop.DOMAIN and id.DOMAIN.
SERVER_IP=
DOMAIN=
# Dedicated private Standard bucket in OCI Object Storage.
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET=storeluma-backups
OCI_ACCESS_KEY=
OCI_SECRET_KEY=
# Optional, only when a GHCR image requires a private pull.
REGISTRY_USER=
REGISTRY_READ_TOKEN=
