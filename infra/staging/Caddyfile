{
	admin off
	auto_https disable_redirects
}

http://storeluma.localhost:9080 {
	redir https://storeluma.localhost:9443{uri} permanent
}

http://storeluma-id.localhost:9080 {
	redir https://storeluma-id.localhost:9443{uri} permanent
}

(staging_tls) {
	tls internal
	header Strict-Transport-Security "max-age=86400"
}

https://storeluma.localhost:9443 {
	import staging_tls
	reverse_proxy gateway:4100
}

https://storeluma-id.localhost:9443 {
	import staging_tls
	@browser path /realms/storeluma/.well-known/openid-configuration /realms/storeluma/protocol/openid-connect/* /realms/storeluma/login-actions/* /resources/*
	handle @browser {
		reverse_proxy keycloak:8080
	}
	respond 404
}
